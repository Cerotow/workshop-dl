using Terraria;
namespace DDmod.Content.NPCs.Boss.Moridor
{
    public class Moridor : ModNPC
    {
        public override void SetStaticDefaults()
        {
           //DisplayName.SetDefault("Moridor");
           //DisplayName.AddTranslation(7, "摩尔利多");
            Main.npcFrameCount[NPC.type] = 2;
        }
        public override string Texture => "DDmod/Content/NPCs/Boss/Moridor/Moridor_Body";
        public static Asset<Texture2D> Foot;
        public static Asset<Texture2D> Head;
        public override void Load()
        {
            Foot = ModContent.Request<Texture2D>("DDmod/Content/NPCs/Boss/Moridor/Moridor_Foot");
            Head = ModContent.Request<Texture2D>("DDmod/Content/NPCs/Boss/Moridor/Moridor_Head");
        }
        public override void SetDefaults()
        {
            NPC.aiStyle = 0;
            NPC.lifeMax = 20000;
            NPC.damage = 80;
            NPC.defense = 2;
            NPC.Dnpc().LifeUP = false;

            NPC.knockBackResist = 0f;
            NPC.width = 150;
            NPC.height = 300;
            NPC.value = Item.buyPrice(0, 0, 0, 50);
            NPC.lavaImmune = false;
            NPC.noGravity = false;
            NPC.noTileCollide = false;
            NPC.HitSound = SoundID.Tink;
            NPC.DeathSound = SoundID.Shatter;
            NPC.netAlways = true;

        }
        public override void SetBestiary(BestiaryDatabase database, BestiaryEntry bestiaryEntry)
        {
            bestiaryEntry.Info.AddRange(new IBestiaryInfoElement[]
            {
                BestiaryDatabaseNPCsPopulator.CommonTags.SpawnConditions.Biomes.Underground,
                BestiaryDatabaseNPCsPopulator.CommonTags.SpawnConditions.Biomes.Caverns,

                new FlavorTextBestiaryInfoElement(Language.GetTextValue("Mods.DDmod.NPCBestiary.LifeWarrior"))
            });
        }
        public override void ModifyHitByItem(Player player, Item item, ref NPC.HitModifiers modifiers)
        {
        }
        public override void ApplyDifficultyAndPlayerScaling(int numPlayers, float balance, float bossAdjustment)
        {
            NPC.lifeMax += (int)(NPC.lifeMax * 0.66f * (bossAdjustment - 1));
        }
        public override void AI()
        {
            NPC.velocity.X = -1f;
            DDHelper.BackAndForth(-1.5f, 1f, 0.01F, ref NPC.rotation,ref NPC.Dnpc().Bool[0]);
        }
        public override bool PreDraw(SpriteBatch spriteBatch, Vector2 screenPos, Color drawColor)
        {
            DrawFoot2(spriteBatch, screenPos, drawColor);
            DrawBody(spriteBatch, screenPos, drawColor);
            DrawHead(spriteBatch, screenPos, drawColor);
            DrawFoot(spriteBatch, screenPos, drawColor);
            return false;
        }
        //绘制头
        public void DrawHead(SpriteBatch spriteBatch, Vector2 screenPos, Color drawColor)
        {
            SpriteEffects spriteEffects = (SpriteEffects)1;
            if (NPC.direction == 1)
            {
                spriteEffects = 0;
            }
            Texture2D texture = Head.Value;
            Vector2 vector = NPC.Center - screenPos - new Vector2(80 * NPC.direction, -60);
            DDHelper.BackAndForth(-1f, 0, 0.02F, ref NPC.Dnpc().Times[0], ref NPC.Dnpc().Bool[1]);
            vector += (new Vector2(84 * NPC.direction, -10) + new Vector2((136 - Foot.Width() / 12) * NPC.direction, -50)).RotatedBy(NPC.rotation);
            spriteBatch.Draw(texture, vector, null, drawColor, NPC.rotation+ NPC.Dnpc().Times[0], new Vector2(texture.Width/2f,texture.Height/4), NPC.scale, spriteEffects, 0f);

        }
        //绘制身体
        public void DrawBody(SpriteBatch spriteBatch, Vector2 screenPos, Color drawColor)
        {
            SpriteEffects spriteEffects = (SpriteEffects)1;
            if (NPC.direction == 1)
            {
                spriteEffects = 0;
            }
            Texture2D texture = TextureAssets.Npc[NPC.type].Value;
            spriteBatch.Draw(texture, NPC.Center - screenPos- new Vector2(80 * NPC.direction, -60), null, drawColor, NPC.rotation, texture.Size() / 2-new Vector2((136 - Foot.Width() / 12) * NPC.direction, -50), NPC.scale, spriteEffects, 0f);
        }
        int Footframe = 4;
        int FootframeCounter;
        //绘制脚
        public void DrawFoot(SpriteBatch spriteBatch, Vector2 screenPos, Color drawColor)
        {
            FootframeCounter++;
            if(FootframeCounter>4)
            {
                Footframe++;
                FootframeCounter = 0;
            }
            if(Footframe>=17)
            {
                Footframe = 0;
            }
            int FrameX = Footframe % 6;
            int FrameY = Footframe / 6;
            SpriteEffects spriteEffects = (SpriteEffects)1;
            if (NPC.direction == 1)
            {
                spriteEffects = 0;
            }
            Texture2D texture = Foot.Value;
            Rectangle? rectangle = new Rectangle?(new Rectangle(texture.Width / 6 * FrameX, texture.Height / 3 * FrameY, texture.Width / 6, texture.Height / 3));
            Vector2 vector = new Vector2(texture.Width / 6, texture.Height / 3) / 2;
            vector += new Vector2(80 * NPC.direction, -100);
            spriteBatch.Draw(texture, NPC.position + new Vector2(NPC.width, NPC.height) / 2 - screenPos, rectangle, drawColor, 0, vector, NPC.scale, spriteEffects, 0f);
        }
        int Footframe2;
        int FootframeCounter2;
        //绘制第二个脚
        public void DrawFoot2(SpriteBatch spriteBatch, Vector2 screenPos, Color drawColor)
        {
            FootframeCounter2++;
            if (FootframeCounter2 > 4)
            {
                Footframe2++;
                FootframeCounter2 = 0;
            }
            if (Footframe2 >= 17)
            {
                Footframe2 = 0;
            }
            int FrameX = Footframe2 % 6;
            int FrameY = Footframe2 / 6;
            SpriteEffects spriteEffects = (SpriteEffects)1;
            if (NPC.direction == 1)
            {
                spriteEffects = 0;
            }
            Texture2D texture = Foot.Value;
            Rectangle? rectangle = new Rectangle?(new Rectangle(texture.Width / 6 * FrameX, texture.Height/3* FrameY, texture.Width / 6, texture.Height / 3));
            drawColor.R -= 150;
            drawColor.G -= 150;
            drawColor.B -= 150;
            Vector2 vector = new Vector2(texture.Width / 6, texture.Height / 3) / 2;
            vector += new Vector2(60 * NPC.direction, -100);
            spriteBatch.Draw(texture, NPC.position + new Vector2(NPC.width, NPC.height) / 2 - screenPos, rectangle, drawColor, 0, vector, NPC.scale, spriteEffects, 0f);
        }
    }
}