        public override bool PreDraw(SpriteBatch spriteBatch, Vector2 screenPos, Color drawColor)
        {
            Texture2D VoidStar = DDTextures.VoidStar.Value;
            Vector2 vector = NPC.Center - screenPos + ((NPC.rotation - MathHelper.PiOver2).ToRotationVector2().PerfectNormalize() * -10* NPC.scale);
            SpriteEffects spriteEffects = 0;
            float RO = 0;
            if (NPC.spriteDirection == 1)
            {
                spriteEffects = SpriteEffects.FlipHorizontally;
                RO = MathHelper.PiOver2;
            }
            for (int a = 0; a < 5; a++)
            {
                spriteBatch.Draw(VoidStar, vector, new Rectangle?(new Rectangle(0, 0, (int)(VoidStar.Width / 1.7F), VoidStar.Height)), new Color(253, 62, 3, 0) * 1f, NPC.rotation - MathHelper.PiOver4 - RO, new Vector2((int)(VoidStar.Width / 1.7F), VoidStar.Height / 2), new Vector2(NPC.scale / 2 * (0.5F + NPC.localAI[0]) * 2, NPC.scale / 3.5F) * (0.25F + NPC.localAI[0]) / 2, 0, 0f);
            }
            //spriteBatch.Draw(VoidStar, vector, new Rectangle?(new Rectangle(0, 0, (int)(VoidStar.Width / 1.7F), VoidStar.Height)), new Color(2, 200, 252, 0) * 0.8f, NPC.rotation - MathHelper.PiOver2, VoidStar.Size()/2, new Vector2(NPC.scale * 1.25f, NPC.scale / 2.5F) / 3F * NPC.localAI[0], 0, 0f);
            spriteBatch.Draw(NPCTexture.Value, NPC.Center - screenPos, new Rectangle?(NPC.frame), drawColor, NPC.rotation, new Vector2(NPCTexture.Width() / 2, NPCTexture.Height() / 2), NPC.scale, spriteEffects, 0f);

            return false;
        }
        public override void PostDraw(SpriteBatch spriteBatch, Vector2 screenPos, Color drawColor)
        {
            SpriteEffects spriteEffects = 0;
            if (NPC.spriteDirection == 1)
            {
                spriteEffects = SpriteEffects.FlipHorizontally;
            }
            spriteBatch.Draw(Glow.Value, NPC.Center - screenPos, new Rectangle?(NPC.frame), Color.White, NPC.rotation, new Vector2(Glow.Width() / 2, Glow.Height() / 2), NPC.scale, spriteEffects, 0f);
        }
