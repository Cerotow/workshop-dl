		# 这是被修改的原版
		Tooltips: {
			#流星盔甲
			MeteorArmor: 头盔自适应增加9%召唤伤害或魔法伤害
			MeteorArmor2: 增加9%召唤伤害
			#暗夜套
			Shadow2: 攻击速度提升7%
			#远古套
			远古套1: 伤害增加12%,暴击率增加5%
			远古套2: 伤害减免增加8%
			远古套3: 移动速度增加10%,跳跃高度提升
			#荆棘法杖
			NettleBurst:
				'''
				使用时会在短暂延迟后会生成一个飞行法阵
				使用右键在老鼠位置召唤荆棘发动攻击
				'''
			#魔法导弹
			MagicMissile:
				'''
				召唤一个可以控制的导弹,随后召唤3枚围绕着自己的导弹
				右键会让所有导弹追踪敌人
				'''
			#烈焰火鞭
			Flamelash:
				'''
				召唤一个可以控制的火球,随后召唤3枚围绕着老鼠的火球
				中心火球消失或者右键会让所有火球追踪敌人
				'''
			#彩虹法杖
			RainbowRod:
				'''
				召唤一个可以控制的彩虹光束,随后召唤4枚围着玩家旋转和2枚围绕着老鼠旋转的彩虹光束
				右键会让所有彩虹光束追踪敌人
				'''
			#水晶蛇
			CrystalSerpent: 召唤三头蛇,右键射出爆炸水晶弹
			#爬藤怪法杖
			ClingerStaff: 召唤一道咒火墙保护你,右键能在老鼠位置画出一道墙
			#生命水晶
			LifeCrystal:
				'''
				你需要击败生命守卫才能食用生命水晶
				当前可用次数：{0}
				'''
			#魔力水晶
			ManaCrystal:
				'''
				你需要击败星辰守卫才能食用魔力水晶
				当前可用次数：{0}
				'''
			#赫尔墨斯之靴
			HermesBoots:
				'''
				在草地和丛林草上跑得更快
				开启可见性能让土块和泥块生成对应的草皮
				穿上草鞋,飞一般的感觉
				'''
			#冰鞋
			FlurryBoots:
				'''
				在雪块上跑的更快
				开启可见性走在水上时,水会结冰
				'''
			#三管猎枪
			Boomstick: 除暴安良是责任,行善积德是兴趣
			Charging: 最大充能倍率
			Charging2: 最大储存{0}次
			ItemsID: 物品ID:
			UseAmmo: 使用弹药:
			#袋子提示
			Bags: 右键打开
			Bags2: 按下智能光标快速查看物品
			#抽奖提示
			抽奖:
				'''
				按下智能光标查看能获得的物品概率
				同时可以跳过动画
				'''
			#法宝
			TalismanKey: 使用法宝
			Talisman: 可以装备在法宝栏
			Damage: 法宝伤害
			Restoration: 治愈生命效果
			RestorationMana: 治愈魔力效果
			Resist: 抵挡伤害
			RestorationCrit: 治愈生命翻倍
			RestorationManaCrit: 治愈魔力翻倍
			ResistCrit: 护盾翻倍
			TalismanCD: 冷却时间: {0}
			TalismanTimes: 持续时间: {0}
			Second: 秒
			Minute: 分
			普通: 普通
			优秀: -优秀-
			优秀2: 优秀+
			稀有: ~稀有~
			稀有2: 稀有+
			史诗: -史诗-
			史诗2: 史诗+
			史诗3: 史诗++
			传说: -传说-
			传说2: 传说+
			传说3: 传授++
			罕见: ~罕见~
			珍宝: ~珍宝~
			泰拉: ~泰拉~
			平平无奇: -平平无奇-
			精良: -精良-
			超凡: -超凡-
			Rightattack: 按住右键进行特殊攻击
			RightTransform: 右键切换武器模式
			RightCharge: 按住右键进行蓄力攻击
			Rightdefense: 按住右键进入防御姿态
			#右键提示
			ConsumesAmmo: "{0}%的几率节省弹药"
			SwordShield:
				'''
				防御姿态:开启时立即清除无敌时间并且额外增加{0}防御
				启用时短时间内会触发格挡,受伤后一定时间内无法举盾
				格挡:抵御{1}%受到的伤害并且反击,强化下一次攻击持续三秒
				'''
			Farmland:
				'''
				可种植在耕好的地上
				成熟后可收获[i:{0}]({1})
				'''
			Placementhints: "{0}未击败前无法在{1}以下放置"
			Placementhints2: "{0}和{1}未击败前无法在{2}以下放置"
			#剑盾
			Placementhints3: "{0}未击败前无法在{1}放置"
			Placementhints4: "{0}和{1}未击败前无法在{2}放置"
			狙击枪: "{$Controls.RightClick}可以看得更远"
		}

